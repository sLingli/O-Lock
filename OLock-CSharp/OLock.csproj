<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>OLock</AssemblyName>
    <Version>1.3.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- 自包含单文件压缩: Full 包 153MB -> 约 62MB，启动多几十毫秒解压（仅独立部署支持压缩） -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <!-- 只保留英文资源，去掉依赖包自带的其余语言资源 -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 调试符号内嵌进 exe，发布产物不再单独带 .pdb -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Update="olock.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OLock.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试子项目有自己的 csproj，避免源文件被主工程 glob 进来 -->
    <Compile Remove="OLock.Tests/**/*.cs" />
  </ItemGroup>

</Project>
